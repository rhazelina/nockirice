font=Noto Sans 11
width=360
height=180
margin=10
padding=12
border-size=1
border-radius=10
outer-margin=12

anchor=top-right
layer=overlay
sort=-time
max-visible=5
max-history=20

background-color=#0F1419FF
text-color=#BFBDB6FF
border-color=#1F2430FF
progress-color=over #E6B450FF
include=~/.config/mako/colors

icons=1
max-icon-size=48
icon-border-radius=6
markup=0
actions=1
history=1
ignore-timeout=1
default-timeout=8000

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss
on-notify=exec pw-play --volume=0.5 /usr/share/sounds/freedesktop/stereo/message.oga

[urgency=low]
default-timeout=3000

[urgency=critical]
default-timeout=15000
border-color=#F07178FF

[mode=do-not-disturb]
invisible=1
