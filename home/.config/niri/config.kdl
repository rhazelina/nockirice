include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"


output "eDP-1" {
    off
}

output "HDMI-A-1" {
    mode "1920x1080@100"
    scale 1
}

// VNC hanya lokal; akses remote lewat SSH tunnel:
// ssh -L 5900:127.0.0.1:5900 user@mesin-ini
spawn-at-startup "wayvnc" "127.0.0.1"

// ArchPurge — Niri floating window rule (generated by `archpurge niri-config`).
// Tempel ke ~/.config/niri/config.kdl di dalam blok `window-rule` / `layer-rule`.
window-rule {
    match title="ArchPurge.*"
    open-floating true
    default-column-width { proportion 0.55; }
    default-window-height { proportion 0.7; }
}

// Keybinding contoh (sesuaikan dengan config Anda):
// binds {
//     Mod+Shift+Delete { spawn "archpurge" "tui"; }
// }

include "noctalia.kdl"
